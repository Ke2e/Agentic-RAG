# ===== LLM（OpenAI 兼容协议）=====
MODEL_NAME=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ===== Embedding（专用端点可选，不填则沿用主 LLM 的 BASE_URL / API_KEY）=====
EMBEDDINGS_MODEL_NAME=text-embedding-v3
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_API_DIMENSIONS=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

# ===== 联网兜底（v4 / v5 需要，https://open.bochaai.com）=====
BOCHA_API_KEY=

# ===== TypeSafe 判断模型（仅 v6 需要，可选）=====
# KEY 为 Vercel AI Gateway 的 API Key（vck_ 前缀），模型 id：typesafe-ai/jev
TYPESAFE_API_KEY=
TYPESAFE_ROUTE_CONFIDENCE_FLOOR=0.7
TYPESAFE_ENOUGH_THRESHOLD=0.75

# ===== Milvus =====
MILVUS_URL=localhost:19530
MILVUS_COLLECTION=ebook_collection

# ===== Elasticsearch =====
ES_NODE=http://localhost:9200
ES_INDEX=ebook_chunks

# ===== 语料（自备 epub，不入库）=====
CORPUS_PATH=./data/天龙八部.epub
BOOK_ID=1
BOOK_TITLE=天龙八部

# ===== 检索参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
ES_TOP_K=5
MAX_RETRIEVALS=8
RRF_K=60

# ===== SSE 服务 =====
PORT=3000
