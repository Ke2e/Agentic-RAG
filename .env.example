# ===== LLM（OpenAI 兼容协议）=====
MODEL_NAME=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ===== Embedding =====
EMBEDDINGS_MODEL_NAME=text-embedding-v3
EMBEDDINGS_DIMENSIONS=1024

# ===== 联网兜底（v4 / v5 需要，https://open.bochaai.com）=====
BOCHA_API_KEY=

# ===== Milvus =====
MILVUS_URL=localhost:19530
MILVUS_COLLECTION=ebook_collection

# ===== Elasticsearch =====
ES_NODE=http://localhost:9200
ES_INDEX=ebook_chunks

# ===== 语料（自备 epub，不入库）=====
CORPUS_PATH=./data/天龙八部.epub
BOOK_ID=1

# ===== 检索参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
ES_TOP_K=5
MAX_RETRIEVALS=8
RRF_K=60

# ===== SSE 服务 =====
PORT=3000
